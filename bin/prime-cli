#!/bin/sh
set -eu
if [ "$#" -eq 0 ]; then
  printf '%s\n' 'prime-cli compatibility wrapper (Harness v2)'
  printf '%s\n' 'commands: start stop restart status doctor run agents send schedule watch log'
  exit 0
fi
command="$1"
shift
HARNESS_BIN="${HARNESS_LAUNCHER:-$(command -v harness || true)}"
if [ -z "$HARNESS_BIN" ]; then
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  HARNESS_BIN="$SCRIPT_DIR/harness"
fi
case "$command" in
  start|stop|restart|status|watch|send|schedule|attach|list)
    exec "$HARNESS_BIN" prime "$command" "$@"
    ;;
  agents)
    exec "$HARNESS_BIN" prime list --all --prime-json "$@"
    ;;
  doctor)
    exec "$HARNESS_BIN" doctor "$@"
    ;;
  run)
    exec "$HARNESS_BIN" run "$@"
    ;;
  log)
    exec "$HARNESS_BIN" log "$@"
    ;;
  *)
    printf 'unknown prime-cli command: %s\n' "$command" >&2
    exit 2
    ;;
esac
